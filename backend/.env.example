DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/constructai"
PORT=5000
JWT_SECRET="change-me"
AUTH_REQUIRED=true

# Platform admin panel.
# Comma-separated list of emails allowed into /api/admin/* and the admin panel.
# Being the owner of your own workspace does NOT grant this — it is Buildsasa staff only.
PLATFORM_ADMIN_EMAILS="you@buildsasa.com"

# Emails that bypass the subscription paywall — free use, never billed, no
# invoices issued. Platform admins are comped automatically, so this is only
# needed for non-admin comped accounts (pilots, partners, VIPs).
FREE_ACCESS_EMAILS=""

# Where new contact-form submissions and demo requests are emailed (optional).
# Leads are always saved to the database regardless; this is just a notification.
LEADS_NOTIFY_EMAIL="sales@buildsasa.com"

# Where locally-uploaded files are written. Leave unset for local development
# (defaults to backend/uploads). In production this MUST point at a mounted
# volume — a container's own filesystem is recreated on every deploy, which
# deletes every uploaded plan, drawing and photo. On Railway: attach a volume
# with mount path /data, then set UPLOAD_DIR=/data/uploads.
# Ignored entirely when S3_BUCKET is set, since uploads then go to the cloud.
UPLOAD_DIR=""

# Largest single file accepted, in MB. Anything bigger is rejected with a clear
# message instead of dying mid-transfer as an unexplained "network error".
MAX_UPLOAD_MB="100"

# Public base URL of THIS API, used to build absolute URLs for locally-stored
# files (e.g. https://api.buildsasa.com). Leave unset and the request's own host
# is used, which is correct behind Railway's proxy. Set it only if something else
# terminates TLS or rewrites the host, otherwise stored image URLs point at the
# wrong origin and every uploaded photo 404s.
PUBLIC_API_URL=""

# ===== Object storage (recommended for production) =====
# Setting S3_BUCKET switches uploads from the container disk to the cloud, which
# is the only durable option across deploys and across multiple instances.
# Works with AWS S3, Cloudflare R2, Backblaze B2 and any S3-compatible store.
# Verify a live configuration end-to-end with GET /api/admin/storage-check
# (platform admins only) — it writes, reads back over the public URL, and
# deletes, reporting each step separately so a credential problem, a private
# bucket and a wrong public URL are told apart.
S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_UPLOAD_PREFIX="uploads/"
# R2 / B2 / MinIO only: the account's S3 API endpoint, e.g.
#   https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# Public base URL files are readable at (a public bucket URL or custom domain).
# Required whenever the bucket is not readable at the default provider URL —
# without it files upload successfully and then cannot be displayed.
S3_PUBLIC_BASE=""
